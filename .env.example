# Data Graph v2 configuration. The server reads exactly these variables
# (see datagraph/settings.py); everything else from the pre-v2 service is gone.
# This file is documentation only — nothing loads .env automatically, so
# export the variables in your shell. Script-side extras: scripts/ui_smoke.py
# also reads DATAGRAPH_CHROME_BIN.

# SQLite data directory (default: ./data). Legacy name DATA_GRAPH_DATA_DIR is
# also accepted.
DATAGRAPH_DATA_DIR=data

# API + UI port (default: 8080). Legacy name DATA_GRAPH_PORT is also accepted.
DATAGRAPH_PORT=8080

# Serve GET/static reads while blocking mutating endpoints. POST /evidence stays
# enabled so agents can record analysis events against a frozen graph.
DATAGRAPH_READ_ONLY=0

# Run cluster/layout jobs in-process instead of a process pool (used by tests
# and the demo-seed serve command). Legacy name DATA_GRAPH_INLINE_CPU_RUNS is
# also accepted.
DATAGRAPH_INLINE_CPU_RUNS=0

# Required for real embedding runs (text-embedding-3-small) and topic labeling
# (gpt-5.4-mini). Not needed for the offline demo, tests, or the "mock"
# embedding provider.
OPENAI_API_KEY=
